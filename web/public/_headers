# Cabeçalhos de segurança do site (Cloudflare Workers, arquivos estáticos).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# O painel da redação não pode ser embutido em outro site (clique disfarçado em "Publicar").
/painel
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
