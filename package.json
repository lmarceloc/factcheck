{
  "name": "factcheck-ao-vivo",
  "version": "0.1.0",
  "private": true,
  "description": "Checagem de fatos em tempo real para debates políticos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --ignore web --ignore data src/server.ts",
    "demo": "DEMO_MODE=true tsx src/server.ts",
    "build": "vite build web",
    "start": "NODE_ENV=production tsx src/server.ts",
    "simulate": "tsx scripts/simulate.ts",
    "typecheck": "tsc -p . && tsc -p web && tsc -p worker && tsc -p worker-app",
    "test": "vitest run",
    "tse:ingest": "tsx scripts/tse-ingest.ts",
    "fontes:sql": "tsx scripts/fontes-sql.ts",
    "cf:prepare": "tsx scripts/cf-prepare.ts && vite build web",
    "cf:dev": "npm run cf:prepare && cd worker-app && wrangler dev",
    "cf:deploy": "npm run cf:prepare && cd worker-app && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
