# Chave da API da OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=

PORT=3000
# Arquivo com os dados do debate (candidatos, contexto). Veja config/debate.example.json
DEBATE_CONFIG=config/debate.json

# Modelos (padrão: gpt-6-luna nas duas etapas)
EXTRACTION_MODEL=gpt-6-luna
VERIFICATION_MODEL=gpt-6-luna
# Esforço de raciocínio: minimal | low | medium | high | xhigh
EXTRACTION_EFFORT=low
VERIFICATION_EFFORT=medium

# Checagens simultâneas e buscas na web por checagem
MAX_CONCURRENT_CHECKS=4
MAX_SEARCHES_PER_CHECK=5

# Publicar no telão sem revisão humana (NÃO recomendado em transmissão ao vivo)
AUTO_PUBLISH=false

# Transcrição em tempo real pelo AssemblyAI (sem a chave, usa o reconhecimento do navegador)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro
# Parâmetros extras do streaming, em query string. Ex.: language_code=pt
ASSEMBLYAI_PARAMS=

# Fontes oficiais (IBGE, BCB, Câmara, Senado, IPEA, Transparência, TSE, LexML)
# auto = usa o gateway do Cloudflare se DATA_GATEWAY_URL existir; senão consulta direto (sem TSE)
DATA_LAYER=auto
DATA_GATEWAY_URL=https://factcheck-dados.manychat-byte.workers.dev
# A mesma senha cadastrada com `wrangler secret put GATEWAY_TOKEN`
DATA_GATEWAY_TOKEN=
# Só para DATA_LAYER=direto (no gateway, a chave fica como secret do Worker)
PORTAL_TRANSPARENCIA_API_KEY=

# Se definido, o painel do checador exige ?token=... (o telão continua aberto)
OPERATOR_TOKEN=
