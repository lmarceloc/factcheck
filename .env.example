# Credencial da API do Claude (ou use `ant auth login`)
ANTHROPIC_API_KEY=

PORT=3000
# Arquivo com os dados do debate (candidatos, contexto). Veja config/debate.example.json
DEBATE_CONFIG=config/debate.json

# Modelos (padrão: claude-opus-5-5 nas duas etapas)
EXTRACTION_MODEL=claude-opus-5-5
VERIFICATION_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max
EXTRACTION_EFFORT=low
VERIFICATION_EFFORT=medium
# Modo rápido (prévia de pesquisa: até ~2,5x mais tokens/s, preço premium). Só na API direta do Claude.
FAST_MODE=false

# Checagens simultâneas e buscas na web por checagem
MAX_CONCURRENT_CHECKS=4
MAX_SEARCHES_PER_CHECK=5

# Publicar no telão sem revisão humana (NÃO recomendado em transmissão ao vivo)
AUTO_PUBLISH=false
